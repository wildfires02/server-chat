# 复制为 .env 后仅用于本机开发。生产环境不得使用 Compose 或这些固定值。
IM_IMAGE=im/im:dev
EXPORTER_IMAGE=im/exporter:dev
MYSQL_IMAGE=mysql:8.4.11
POSTGRES_IMAGE=postgres:17.10-alpine3.23
MONGODB_IMAGE=mongo:8.0.26
RETHINKDB_IMAGE=rethinkdb:2.4.4-bookworm-slim
ETCD_IMAGE=gcr.io/etcd-development/etcd:v3.7.1

MYSQL_ROOT_PASSWORD=local-im-password
POSTGRES_PASSWORD=local-im-password

# init 只在数据库不存在时建库；upgrade 显式升级；reset 还需要 destructive 开关。
IM_DB_INIT_MODE=init
IM_ALLOW_DESTRUCTIVE_DB_RESET=false
