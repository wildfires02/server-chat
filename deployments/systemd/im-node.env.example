# 复制为 /etc/im/im-im-0.env、im-im-1.env 或 im-im-2.env，并设置 im:im 0400。
# 示例值均不可用于生产；实际文件应由 Vault、SOPS 或企业 Secret Agent 生成。
IM_API_KEY_SALT=replace-with-base64-secret
IM_AUTH_CONFIG__TOKEN__KEY=replace-with-base64-secret
IM_STORE_CONFIG__UID_KEY=replace-with-base64-secret
IM_STORE_CONFIG__ADAPTERS__POSTGRES__DSN=postgresql://im:replace-me@postgres.internal:5432/im?sslmode=verify-full
IM_CLUSTER_CONFIG__CONTROL_PLANE__USERNAME=replace-me
IM_CLUSTER_CONFIG__CONTROL_PLANE__PASSWORD=replace-me
IM_MEDIA__HANDLERS__S3__ACCESS_KEY_ID=replace-me
IM_MEDIA__HANDLERS__S3__SECRET_ACCESS_KEY=replace-me
IM_MEDIA__HANDLERS__S3__REGION=replace-me
IM_MEDIA__HANDLERS__S3__BUCKET=replace-me
IM_MEDIA__HANDLERS__S3__ENDPOINT=https://s3.internal
