[Unit]
Description=IM 生产集群节点 %i
Documentation=file:///usr/share/doc/im-server/systemd-cluster.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=im
Group=im
WorkingDirectory=/var/lib/im

# 节点身份来自 systemd 实例名，例如 im-server@im-0.service。
Environment="IM_CLUSTER_CONFIG__SELF=%i"
Environment="IM_CLUSTER_CONFIG__ADVERTISE_ADDR=%i.im.internal:12000"
Environment="IM_CLUSTER_CONFIG__TLS__CERT_FILE=/etc/im/tls/cluster/%i/cert.pem"
Environment="IM_CLUSTER_CONFIG__TLS__KEY_FILE=/etc/im/tls/cluster/%i/key.pem"
# 每台机器的环境文件由 Secret 管理系统落盘，必须设置为 im:im 0400。
# 缺少该文件时拒绝启动，避免使用空密钥进入运行期。
EnvironmentFile=/etc/im/im-%i.env

# 启动前只做离线结构和生产门禁检查；数据库迁移必须由独立作业执行。
ExecStartPre=/usr/local/bin/im-server --config=/etc/im/im.cluster.yaml --cluster_self=%i --validate_config
ExecStart=/usr/local/bin/im-server --config=/etc/im/im.cluster.yaml --cluster_self=%i --static_data=-
# 先同步 Drain 并等待可靠队列排空，然后 systemd 再发送 SIGTERM。
ExecStop=/usr/bin/curl --fail --silent --show-error --max-time 40 --request POST http://127.0.0.1:6060/drainz
KillSignal=SIGTERM
TimeoutStopSec=60s
Restart=on-failure
RestartSec=5s

# Go 服务的文件描述符和调度容量上限。
LimitNOFILE=1048576
TasksMax=16384
UMask=0077

# systemd 沙箱：服务只需网络、只读配置和临时目录。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=im

[Install]
WantedBy=multi-user.target
